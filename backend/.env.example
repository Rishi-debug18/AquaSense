# AquaSense Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aquasense:aquasense123@localhost:5432/aquasense

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production-use-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Device Config ────────────────────────────────────────────────────────────
DEVICE_OFFLINE_TIMEOUT_MINUTES=15

# ─── Alert Thresholds ─────────────────────────────────────────────────────────
LEAK_THRESHOLD_PERCENT=5.0
HIGH_USAGE_THRESHOLD_PERCENT=50.0
VERY_HIGH_USAGE_THRESHOLD_PERCENT=100.0

# ─── AI Features (Optional) ───────────────────────────────────────────────────
# Leave empty to use rule-based AI assistant only
# Get your key from: https://ai.google.dev/
GEMINI_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In development these defaults are fine.
# In production, set to your actual frontend domain.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
